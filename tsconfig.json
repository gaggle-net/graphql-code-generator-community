{
  "compilerOptions": {
    "incremental": true,
    "baseUrl": ".",
    "outDir": "dist",
    "rootDir": "packages",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "importHelpers": true,
    "experimentalDecorators": true,
    "module": "esnext",
    "target": "es2018",
    "lib": ["es6", "esnext", "es2015", "dom"],
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "sourceMap": true,
    "declaration": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "@gaggle/typescript-apollo-angular": [
        "packages/plugins/typescript/apollo-angular/src/index.ts"
      ],
    }
  },
  "include": ["packages"],
  "exclude": [
    "**/dist",
    "**/temp",
    "**/vitest.config.ts",
    "**/vitest.setup.ts",
    "**/*.spec.ts",
    "**/tests/**/*.ts",
    "**/tests/test-files",
    "**/tests/test-documents"
  ],
  "references": [
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
